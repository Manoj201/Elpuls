rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only read/write their own profile, except the Pro fields:
    // those are written only by Cloud Functions (functions/src/proStatus.ts)
    // from RevenueCat's records, so nobody can switch on Pro pushes for free.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read, delete: if isOwner();
      allow create: if isOwner()
        && !request.resource.data.keys().hasAny(['isProSubscriber', 'proExpiresAt', 'proCheckedAt']);
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isProSubscriber', 'proExpiresAt', 'proCheckedAt']);
    }

    // Appliances registered via photo scan — self-owned like /users.
    match /users/{userId}/appliances/{applianceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Prices and weather are region-level, cached-from-upstream data:
    // readable by any signed-in user, writable only by Cloud Functions
    // (which use the Admin SDK and bypass these rules).
    match /prices/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /weather/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Push subscriptions are keyed by uid, self-owned like /users.
    match /pushSubscriptions/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notification dispatch markers: Cloud Functions only, via Admin SDK.
    match /priceNotifications/{docId} {
      allow read, write: if false;
    }

    // AI-generated "why is it expensive" explainers, region-level like
    // prices/weather: readable by any signed-in user, written only by
    // Cloud Functions.
    match /explainers/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 7-day + seasonal outlook (zone-level), written by Cloud Functions only.
    // history/{zone} (the model's training data) has no rule: default deny.
    match /outlooks/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // "Din plan": zone-level daily plan, written by Cloud Functions only.
    match /plans/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

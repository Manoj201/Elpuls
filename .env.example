# Copy this file to .env and fill in values from your Firebase project
# settings (Project settings > General > Your apps > SDK setup and
# configuration). Expo only exposes vars prefixed with EXPO_PUBLIC_ to the
# client bundle, so these are safe to include there.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From your RevenueCat project (Project settings > API keys). Each store has
# its own public SDK key. Leave both blank to run free-tier only — the app
# skips RevenueCat entirely rather than failing when these aren't set
# (src/lib/purchases.ts). Real purchases also need actual IAP products
# created in App Store Connect / Play Console and linked in RevenueCat —
# that's external dashboard work, not something this repo can set up.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
